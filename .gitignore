# -----------------------------------------------------------------------
# MEDICAL DATA — never commit patient or research-subject data
# -----------------------------------------------------------------------
# DICOM files
*.dcm
*.dicom
*.DCM

# Hologic proprietary files extracted from DICOM
*.bin
*.p_file
*.r_file

# Research exports that may contain PHI
*.hdf5
*.h5
*.zarr/

# CSV / spreadsheet exports from clinical systems
*_apex_*.csv
*_hologic_*.csv

# Point clouds / meshes from BodyLoop (may contain biometric data)
*.ply
*.obj
*.stl
*.pcd

# Output directories (define via OUTPUT_DIR env var)
output/
outputs/
results/

# Configuration overrides with real paths or credentials
.env.local
config/local_*.yml
config/*_real.yml
config/*_production.yml

# Lock files (keep environment.yml as the source of truth for conda;
# for pip, add requirements*.txt only if generated by CI)
# Uncomment the next line if you use pip-compile:
# !requirements*.txt
